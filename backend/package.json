{
  "name": "backend",
  "version": "1.0.0",
  "description": "This directory is reserved for the Talvix Node.js and Express modular monolith. Keeping the backend at this boundary supports independent testing and deployment to Render while all business modules remain in one application.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:demo": "node src/scripts/seedDemo.js",
    "seed:notification-templates": "node src/scripts/seedNotificationTemplates.js",
    "storage:reconcile": "node src/scripts/reconcileStorageUsage.js",
    "storage:smoke:cloudinary": "node src/scripts/smokeCloudinaryStorage.js",
    "backup:mongodb": "node ../ops/scripts/mongodb-backup.mjs",
    "restore:mongodb": "node ../ops/scripts/mongodb-restore.mjs",
    "health:check": "node ../ops/scripts/health-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
