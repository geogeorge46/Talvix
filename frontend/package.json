    "@radix-ui/react-tabs": "1.1.17",
    "@tanstack/react-query": "5.101.2",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@emnapi/wasi-threads": "1.2.2",
    "@eslint/js": "9.39.5",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
